# DeepSeek API key — get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek OpenAI-compatible endpoint (do not change)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Model: deepseek-chat is the cost-efficient choice
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Paid report delivery
# ---------------------------------------------------------------------------
# Price in cents. 9900 = R99.00
REPORT_PRICE_CENTS=9900
REPORT_CURRENCY=ZAR

# Payment gateway. "dev" takes no money and REFUSES to run unless you also set
# PAYMENTS_ALLOW_DEV=true, so production cannot accidentally give reports away.
PAYMENT_PROVIDER=dev
PAYMENTS_ALLOW_DEV=true

# Email delivery. "console" prints instead of sending, which is the safe default
# for local work. Use "resend" or "smtp" for real delivery.
EMAIL_PROVIDER=console
EMAIL_FROM=Legal-Eye <reports@legal-eye.co.za>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Where orders are stored, and how long report bodies are retained after
# delivery before being purged (POPIA s 14).
ORDERS_DB_PATH=orders.db
REPORT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Business details shown on the Terms and Privacy pages
# ---------------------------------------------------------------------------
# These are legally required disclosures, not decoration. ECTA s 43(1) requires
# a supplier selling electronically to publish its name, physical address and
# telephone number, and POPIA s 18 requires the responsible party to identify
# itself. Anything left unset renders on the page as a visible
# "TO BE COMPLETED BEFORE LAUNCH" marker and is reported by
# backend.business.missing_disclosures(), so a half-finished disclosure cannot
# reach a reader quietly.
#
# Legal-Eye trades as a SOLE PROPRIETORSHIP: there is no registration number
# and there are no directors, and the pages say so rather than leaving the rows
# blank. It is also NOT a registered VAT vendor, so no page claims a price
# includes VAT — VAT Act s 65 makes that an offence for a non-vendor.

# Full name of the proprietor, exactly as it appears on the ID document.
BUSINESS_PROPRIETOR=Lizalise Sive Nzo

# Physical street address. A PO box will not do: ECTA s 43(1)(b) asks for a
# physical address, and it doubles as the address for legal service.
BUSINESS_ADDRESS=

# Contact telephone number, in international format, e.g. +27 82 000 0000
BUSINESS_PHONE=

# Address for complaints, refunds and POPIA requests. Worth pointing at a
# dedicated mailbox rather than a personal one: it appears on a public page.
BUSINESS_EMAIL=lizalisenzo@revidarch.com

# Country where document text is analysed, disclosed under POPIA s 72. Change
# this if you change AI provider.
AI_PROVIDER_COUNTRY=the People's Republic of China
